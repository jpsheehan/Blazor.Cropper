<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <TargetFramework>net10.0</TargetFramework>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <Description>A blazor library provide a component to crop images</Description>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageProjectUrl>https://github.com/jpsheehan/Blazor.Cropper</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jpsheehan/Blazor.Cropper</RepositoryUrl>
    <PackageTags>Blazor,Cropper,Crop,Image</PackageTags>
    <PackageId>Sheehan.Blazor.Cropper</PackageId>
    <Version>1.3.0</Version>
    <PackageReleaseNotes>Use SkiaSharp instead of SixLabors.ImageSharp.</PackageReleaseNotes>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <WarningLevel>4</WarningLevel>
    <DocumentationFile>.\Blazor.Cropper\Blazor.Cropper.xml</DocumentationFile>
  </PropertyGroup>
  
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.153.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.WebAssembly" Version="4.153.1" />
  </ItemGroup>
  
  <ItemGroup>
    <InternalsVisibleTo Include="Blazor.Cropper.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\LICENSE">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
